#!/usr/bin/env bash
# Project-scoped wrapper around the Rebble pebble-sdk Docker image. Mirrors
# scripts/pebble-doom but bind-mounts digits/ instead of the repo root
# (which is the Glance watchface).
#
# Usage:
#   ./scripts/pebble-digits build
#   ./scripts/pebble-digits install --phone <ip>
#   ./scripts/pebble-digits logs --phone <ip>
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR="${REPO_ROOT}/digits"
IMAGE="${PEBBLE_SDK_IMAGE:-rebble/pebble-sdk:latest}"

if [ -t 0 ] && [ -t 1 ]; then
  TTY_FLAGS=(-it)
else
  TTY_FLAGS=(-i)
fi

exec docker run --rm "${TTY_FLAGS[@]}" \
  -v "${PROJECT_DIR}:/home/pebble/project" \
  -w /home/pebble/project \
  --network host \
  "${IMAGE}" \
  pebble "$@"
