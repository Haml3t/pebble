#!/usr/bin/env bash
# Builds the Glance NP Android companion APK via cimg/android Docker image.
# Output: build/glance-np.apk (debug-signed, sideloadable).
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="${ANDROID_BUILD_IMAGE:-cimg/android:2024.10}"

# Mirror the editor assets from tools/audio-editor/ into the Android assets
# bundle before each build. There's one source of truth — the laptop tree —
# and any drift between the two has caused real bugs (laptop UI shipped a
# feature the phone-side WebView didn't have).
SRC_ASSETS="${PROJECT_DIR}/tools/audio-editor"
DST_ASSETS="${PROJECT_DIR}/android/app/src/main/assets/audio-editor"
mkdir -p "${DST_ASSETS}"
for f in app.js index.html style.css; do
  cp "${SRC_ASSETS}/${f}" "${DST_ASSETS}/${f}"
done

# Persist the debug keystore across builds. Without this, every container
# generates a fresh ~/.android/debug.keystore, and `adb install -r` rejects
# the new APK because the signature changed — forcing an uninstall, which
# wipes notification + mic permission grants every time.
mkdir -p "${PROJECT_DIR}/android/.android-home"

docker run --rm \
  -v "${PROJECT_DIR}:/proj" \
  -v "${PROJECT_DIR}/android/.android-home:/root/.android" \
  -w /proj/android \
  --user root \
  "${IMAGE}" \
  gradle assembleDebug --no-daemon

docker run --rm \
  -v "${PROJECT_DIR}:/proj" \
  --user root \
  "${IMAGE}" \
  chown -R "$(id -u):$(id -g)" /proj/android/.gradle /proj/android/app/build /proj/build

mkdir -p "${PROJECT_DIR}/build"
cp "${PROJECT_DIR}/android/app/build/outputs/apk/debug/app-debug.apk" \
   "${PROJECT_DIR}/build/glance-np.apk"
echo "→ build/glance-np.apk"
ls -lh "${PROJECT_DIR}/build/glance-np.apk"
